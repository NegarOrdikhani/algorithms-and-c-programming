
// fig06_14.c
// جست‌وجوی خطی در یک آرایه (Linear Search)

#include <stdio.h>

#define SIZE 100  // تعداد عناصر آرایه

// -------------------- اعلان تابع --------------------

// جست‌وجوی مقدار key در آرایه
// در صورت پیدا شدن، اندیس عنصر را برمی‌گرداند
// در صورت پیدا نشدن، مقدار 1- را برمی‌گرداند
int linearSearch(const int array[], int key, size_t size);


// -------------------- تابع اصلی --------------------

int main(void)
{
    // تعریف آرایه‌ای با 100 عنصر و مقداردهی اولیه با صفر
    int a[SIZE] = {0};

    // تولید داده‌های آرایه
    // عناصر آرایه شامل اعداد زوج از 0 تا 198 هستند
    for (size_t x = 0; x < SIZE; ++x)
    {
        a[x] = 2 * x;
    }

    // دریافت عدد موردنظر از کاربر
    printf("Enter integer search key: ");

    int searchKey = 0;

    // خواندن عدد ورودی
    scanf("%d", &searchKey);

    // فراخوانی تابع جست‌وجوی خطی
    // آرایه، مقدار موردنظر و تعداد عناصر به تابع ارسال می‌شوند
    int subscript = linearSearch(a, searchKey, SIZE);

    // بررسی نتیجه جست‌وجو
    if (subscript != -1)
    {
        // اگر مقدار پیدا شده باشد، اندیس آن نمایش داده می‌شود
        printf("Found value at subscript %d\n", subscript);
    }
    else
    {
        // اگر مقدار پیدا نشده باشد، این پیام نمایش داده می‌شود
        puts("Value not found");
    }

    return 0; // پایان اجرای برنامه
}


// -------------------- تابع جست‌وجوی خطی --------------------

int linearSearch(const int array[], int key, size_t size)
{
    // پیمایش آرایه از اولین عنصر تا آخرین عنصر
    for (size_t n = 0; n < size; ++n)
    {
        // مقایسه عنصر فعلی آرایه با مقدار موردنظر
        if (array[n] == key)
        {
            // اگر مقدار پیدا شد، اندیس آن برگردانده می‌شود
            return (int)n;
        }
    }

    // اگر حلقه تمام شود و مقدار پیدا نشده باشد
    return -1;
}





 
// fig06_15.c
// جست‌وجوی دودویی در یک آرایه مرتب‌شده (Binary Search)

#include <stdio.h>

#define SIZE 15  // تعداد عناصر آرایه

// -------------------- اعلان توابع --------------------

// جست‌وجوی دودویی مقدار key در آرایه مرتب‌شده
// low: اندیس شروع محدوده جست‌وجو
// high: اندیس پایان محدوده جست‌وجو
int binarySearch(const int b[], int key, size_t low, size_t high);

// چاپ عنوان و اندیس‌های آرایه
void printHeader(void);

// چاپ وضعیت محدوده جست‌وجو در هر مرحله
void printRow(const int b[], size_t low, size_t mid, size_t high);


// -------------------- تابع اصلی --------------------

int main(void)
{
    // تعریف آرایه‌ای با 15 عنصر
    int a[SIZE] = {0};

    // مقداردهی آرایه با اعداد زوج از صفر تا 28
    // آرایه به صورت صعودی مرتب است
    for (size_t i = 0; i < SIZE; ++i)
    {
        a[i] = 2 * i;
    }

    // دریافت عدد موردنظر از کاربر
    printf("Enter a number between 0 and 28: ");

    int key = 0;

    scanf("%d", &key);

    // نمایش عنوان و اندیس‌های آرایه
    printHeader();

    // فراخوانی تابع جست‌وجوی دودویی
    // محدوده اولیه جست‌وجو از اندیس صفر تا اندیس 14 است
    int result = binarySearch(a, key, 0, SIZE - 1);

    // بررسی نتیجه جست‌وجو
    if (result != -1)
    {
        // نمایش مقدار پیدا شده و اندیس آن
        printf("\n%d found at subscript %d\n", key, result);
    }
    else
    {
        // اگر مقدار در آرایه وجود نداشته باشد
        printf("\n%d not found\n", key);
    }

    return 0; // پایان اجرای برنامه
}


// -------------------- تابع جست‌وجوی دودویی --------------------

int binarySearch(const int b[], int key, size_t low, size_t high)
{
    // تا زمانی که محدوده جست‌وجو معتبر است، جست‌وجو ادامه دارد
    while (low <= high)
    {
        // محاسبه اندیس عنصر وسط محدوده
        size_t middle = low + (high - low) / 2;

        // نمایش محدوده فعلی جست‌وجو و عنصر وسط
        printRow(b, low, middle, high);

        // بررسی اینکه آیا عنصر وسط همان مقدار موردنظر است
        if (key == b[middle])
        {
            // اگر برابر باشد، اندیس عنصر وسط برگردانده می‌شود
            return (int)middle;
        }

        // اگر مقدار موردنظر از عنصر وسط کوچک‌تر باشد
        else if (key < b[middle])
        {
            // جست‌وجو در نیمه سمت چپ ادامه پیدا می‌کند
            high = middle - 1;
        }

        // اگر مقدار موردنظر از عنصر وسط بزرگ‌تر باشد
        else
        {
            // جست‌وجو در نیمه سمت راست ادامه پیدا می‌کند
            low = middle + 1;
        }
    }

    // اگر محدوده جست‌وجو تمام شود و مقدار پیدا نشود
    return -1;
}


// -------------------- تابع چاپ عنوان آرایه --------------------

void printHeader(void)
{
    // نمایش عنوان ستون اندیس‌ها
    puts("\nSubscripts:");

    // چاپ اندیس عناصر آرایه از صفر تا 14
    for (int i = 0; i < SIZE; ++i)
    {
        printf("%3d ", i);
    }

    puts(""); // رفتن به خط بعد

    // چاپ خط جداکننده
    for (int i = 1; i <= 4 * SIZE; ++i)
    {
        printf("-");
    }

    puts(""); // رفتن به خط بعد
}


// -------------------- تابع نمایش وضعیت جست‌وجو --------------------

void printRow(const int b[], size_t low, size_t mid, size_t high)
{
    // پیمایش تمام عناصر آرایه برای نمایش وضعیت جست‌وجو
    for (size_t i = 0; i < SIZE; ++i)
    {
        // اگر عنصر خارج از محدوده فعلی جست‌وجو باشد
        if (i < low || i > high)
        {
            // به جای مقدار آن، فاصله چاپ می‌شود
            printf("    ");
        }

        // اگر عنصر، عنصر وسط محدوده باشد
        else if (i == mid)
        {
            // نمایش عنصر وسط با علامت ستاره
            printf("%3d*", b[i]);
        }

        // سایر عناصر داخل محدوده جست‌وجو
        else
        {
            printf("%3d ", b[i]);
        }
    }

    puts(""); // رفتن به خط بعد برای نمایش مرحله بعد
}
