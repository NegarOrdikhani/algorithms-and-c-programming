// fig06_13.c
// تحليل داده‌هاي يک نظرسنجي با استفاده از آرايه‌ها
// محاسبه ميانگين (Mean)، ميانه (Median) و نما (Mode)

#include <stdio.h>

#define SIZE 99       // تعداد کل پاسخ‌هاي نظرسنجي
#define FREQUENCY_SIZE 10 // اندازه آرايه فراواني؛ انديس‌هاي 1 تا 9 استفاده مي‌شوند

// -------------------- اعلان توابع (Function Prototypes) --------------------

// محاسبه ميانگين پاسخ‌ها
void mean(const int answer[]);

// مرتب‌سازي آرايه و محاسبه ميانه
void median(int answer[]);

// محاسبه نما با استفاده از آرايه فراواني
void mode(int freq[], const int answer[]);

// مرتب‌سازي حبابي آرايه به ترتيب صعودي
void bubbleSort(int a[]);

// چاپ عناصر آرايه
void printArray(const int a[]);


// -------------------- تابع اصلي برنامه --------------------

int main(void)
{
    // تعريف آرايه پاسخ‌هاي نظرسنجي و مقدار دهي اوليه آن
    int response[SIZE] = {
        6, 7, 8, 9, 8, 7, 8, 9, 8, 9,
        7, 8, 9, 5, 9, 8, 7, 8, 7, 8,
        6, 7, 8, 9, 3, 9, 8, 7, 8, 7,
        7, 8, 9, 8, 9, 8, 9, 7, 8, 9,
        6, 7, 8, 7, 8, 7, 9, 8, 9, 2,
        7, 8, 9, 8, 9, 8, 9, 7, 5, 3,
        5, 6, 7, 2, 5, 3, 9, 4, 6, 4,
        7, 8, 9, 6, 8, 7, 8, 9, 7, 8,
        7, 4, 4, 2, 5, 3, 8, 7, 5, 6,
        4, 5, 6, 1, 6, 5, 7, 8, 7
    };

    // تعريف آرايه فراواني و مقدار دهي تمام خانه هاي آن با صفر
    // frequency[i] تعداد تکرار عدد i را نگهداري مي کند
    int frequency[FREQUENCY_SIZE] = {0};

    // -------------------- محاسبه ميانگين --------------------

    printf("%s\n%s\n%s\n", "--------", "  Mean", "--------");

    // ارسال آرايه پاسخ ها به تابع محاسبه ميانگين
    mean(response);


    // -------------------- محاسبه ميانه --------------------

    printf("\n%s\n%s\n%s\n", "--------", " Median", "--------");

    // ارسال آرايه پاسخ ها به تابع محاسبه ميانه
    median(response);


    // -------------------- محاسبه نما --------------------

    printf("\n%s\n%s\n%s\n", "--------", "  Mode", "--------");

    // ارسال آرايه فراواني و آرايه پاسخ ها به تابع محاسبه نما
    mode(frequency, response);

    return 0; // پايان موفقيت آميز برنامه
}


// -------------------- تابع محاسبه ميانگين (Mean) --------------------

void mean(const int answer[])
{
    int total = 0; // متغيري براي نگهداري مجموع پاسخ ها

    // جمع کردن تمام عناصر آرايه
    for (size_t j = 0; j < SIZE; ++j)
    {
        total += answer[j];
    }

    // محاسبه و نمايش ميانگين
    // ميانگين برابر است با مجموع داده ها تقسيم بر تعداد آن ها
    printf("The mean is the average value of the data\n"
           "items. The mean is equal to the total of\n"
           "all the data items divided by the number\n"
           "of data items (%d).\n"
           "The mean value for this run is: %d / %d = %.4f\n",
           SIZE, total, SIZE, (double)total / SIZE);
}


// -------------------- تابع محاسبه ميانه (Median) --------------------

void median(int answer[])
{
    // ابتدا آرايه مرتب نشده را نمايش مي دهيم
    printf("The unsorted array of responses is:\n");

    printArray(answer);

    // مرتب سازي آرايه به ترتيب صعودي
    bubbleSort(answer);

    // نمايش آرايه مرتب شده
    printf("\nThe sorted array of responses is:\n");

    printArray(answer);

    // چون تعداد عناصر 99 است، عنصر وسط در انديس 49 قرار دارد
    // در آرايه با انديس گذاري از صفر، عنصر وسط در SIZE / 2 است
    printf("\nThe median is %d\n", answer[SIZE / 2]);
}


// -------------------- تابع محاسبه نما (Mode) --------------------

void mode(int freq[], const int answer[])
{
    int highest = 0; // متغيري براي نگهداري بيشترين فراواني

    // شمارش تعداد تکرار هر پاسخ
    for (size_t rating = 0; rating < SIZE; ++rating)
    {
        // مقدار هر پاسخ به عنوان انديس آرايه فراواني استفاده مي شود
        // مثلا اگر پاسخ 8 باشد، يک واحد به freq[8] اضافه مي شود
        ++freq[answer[rating]];
    }

    // پيدا کردن بيشترين مقدار فراواني
    for (size_t rating = 1; rating < FREQUENCY_SIZE; ++rating)
    {
        if (freq[rating] > highest)
        {
            highest = freq[rating];
        }
    }

    // نمايش مقدار بيشترين فراواني
    printf("The mode is the most frequent value.\n");
    printf("The highest frequency is %d.\n", highest);

    // نمايش تمام پاسخ هايي که بيشترين فراواني را دارند
    // اگر چند مقدار فراواني برابر داشته باشند، همه آن ها نما هستند
    printf("The mode(s) is/are: ");

    for (size_t rating = 1; rating < FREQUENCY_SIZE; ++rating)
    {
        if (freq[rating] == highest)
        {
            printf("%zu ", rating);
        }
    }

    printf("\n");
}


// -------------------- تابع مرتب سازي حبابي (Bubble Sort) --------------------

void bubbleSort(int a[])
{
    // حلقه بيروني تعداد دفعات عبور از آرايه را کنترل مي کند
    for (int pass = 1; pass < SIZE; ++pass)
    {
        // حلقه داخلي عناصر مجاور را با يکديگر مقايسه مي کند
        for (size_t j = 0; j < SIZE - 1; ++j)
        {
            // اگر عنصر فعلي از عنصر بعدي بزرگ تر باشد، جابه جا مي شوند
            if (a[j] > a[j + 1])
            {
                // نگهداري موقت مقدار عنصر فعلي
                int hold = a[j];

                // انتقال عنصر بعدي به خانه فعلي
                a[j] = a[j + 1];

                // قرار دادن مقدار قبلي عنصر فعلي در خانه بعدي
                a[j + 1] = hold;
            }
        }
    }
}


// -------------------- تابع چاپ آرايه (Print Array) --------------------

void printArray(const int a[])
{
    // چاپ تمام عناصر آرايه
    for (size_t j = 0; j < SIZE; ++j)
    {
        // چاپ هر عنصر با عرض حداقل 3 کاراکتر
        printf("%3d", a[j]);

        // بعد از هر 20 عنصر، به خط بعد مي رويم
        if ((j + 1) % 20 == 0)
        {
            puts("");
        }
    }

    puts(""); // چاپ يک خط خالي در انتهاي آرايه
}
