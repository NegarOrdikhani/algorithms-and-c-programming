// fig05_02.c
// Finding the maximum of three integers.
// پیدا کردن بزرگ‌ترین عدد از بین سه عدد صحیح

#include <stdio.h>

// function prototype
// نمونه اولیه تابع maximum
// سه پارامتر از نوع int دریافت می‌کند و یک int برمی‌گرداند
int maximum(int x, int y, int z);

int main(void) {
   // تعریف و مقداردهی اولیه سه متغیر برای دریافت ورودی کاربر
   int number1 = 0; // first integer entered by the user
   int number2 = 0; // second integer entered by the user
   int number3 = 0; // third integer entered by the user

   // درخواست ورود سه عدد صحیح
   printf("%s", "Enter three integers: ");

   // خواندن سه عدد و ذخیره آن‌ها در متغیرهای مربوطه
   // & آدرس هر متغیر را به scanf می‌دهد
   scanf("%d%d%d", &number1, &number2, &number3);

   // number1, number2 and number3 are arguments
   // to the maximum function call
   // سه متغیر زیر آرگومان‌های ارسالی به تابع maximum هستند
   // مقدار بازگشتی تابع با %d نمایش داده می‌شود
   printf("Maximum is: %d\n",
          maximum(number1, number2, number3));
}

// Function maximum definition
// تعریف تابع maximum برای یافتن بزرگ‌ترین عدد
int maximum(int x, int y, int z) {

   // assume x is largest
   // در ابتدا فرض می‌کنیم x بزرگ‌ترین عدد است
   int max = x;

   // if y is larger than max
   // اگر y از بزرگ‌ترین مقدار فعلی بیشتر باشد
   if (y > max) {

      // assign y to max
      // مقدار y به‌عنوان بزرگ‌ترین مقدار فعلی ثبت می‌شود
      max = y;
   }

   // if z is larger than max
   // اگر z از بزرگ‌ترین مقدار فعلی بیشتر باشد
   if (z > max) {

      // assign z to max
      // مقدار z به‌عنوان بزرگ‌ترین مقدار فعلی ثبت می‌شود
      max = z;
   }

   // max is largest value
   // بازگرداندن بزرگ‌ترین مقدار پیدا شده
   return max;
}



