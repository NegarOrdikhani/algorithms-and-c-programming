
// حالت اول: Pointer معمولی
// هم مقدار داده و هم آدرس اشاره‌گر قابل تغییر هستند

#include <stdio.h>

int main(void)
{
    int x = 10;
    int y = 20;

    // اشاره‌گر به متغیر x
    int *ptr = &x;

    // تغییر مقدار متغیر x از طریق اشاره‌گر
    *ptr = 15;

    printf("x = %d\n", x);

    // تغییر آدرس اشاره‌گر از x به y
    ptr = &y;

    // تغییر مقدار متغیر y از طریق اشاره‌گر
    *ptr = 25;

    printf("y = %d\n", y);

    return 0;
}





// حالت دوم: Pointer to Constant
// مقدار داده از طریق اشاره‌گر قابل تغییر نیست
// اما آدرس اشاره‌گر قابل تغییر است

#include <stdio.h>

int main(void)
{
    int x = 10;
    int y = 20;

    // اشاره‌گر به داده‌ای که از طریق ptr قابل تغییر نیست
    const int *ptr = &x;

    // خواندن مقدار x
    printf("Value of x = %d\n", *ptr);

    // تغییر آدرس اشاره‌گر به y
    ptr = &y;

    // خواندن مقدار y
    printf("Value of y = %d\n", *ptr);

    // دستور زیر غیرمجاز است:
    // *ptr = 30;

    // تغییر مستقیم x همچنان مجاز است
    x = 30;

    return 0;
}





// حالت سوم: Constant Pointer
// آدرس اشاره‌گر ثابت است
// اما مقدار داده قابل تغییر است

#include <stdio.h>

int main(void)
{
    int x = 10;
    int y = 20;

    // اشاره‌گر ثابت به متغیر x
    // باید هنگام تعریف مقداردهی اولیه شود
    int *const ptr = &x;

    // تغییر مقدار متغیر x از طریق اشاره‌گر
    *ptr = 50;

    printf("x = %d\n", x);

    // دستور زیر غیرمجاز است:
    // ptr = &y;

    return 0;
}




// حالت چهارم: Constant Pointer to Constant
// هم مقدار داده و هم آدرس اشاره‌گر محدود شده‌اند

#include <stdio.h>

int main(void)
{
    int x = 10;
    int y = 20;

    // اشاره‌گر ثابت به داده ثابت
    const int *const ptr = &x;

    // خواندن مقدار متغیر x
    printf("Value = %d\n", *ptr);

    // دستور زیر غیرمجاز است:
    // *ptr = 50;

    // دستور زیر نیز غیرمجاز است:
    // ptr = &y;

    return 0;
}



